# Copy to .env for local runs. The Docker image sets its own values, and on
# Fly.io use `fly secrets set` for anything sensitive (see DEPLOY.md).

PORT=3000
DB_PATH=./cricket.db
WEB_ROOT=./web/dist

# Production MUST override this with a long random value, e.g. `openssl rand -base64 32`.
JWT_SECRET=dev-secret-change-me

# 'dev' logs the one-time code to the server console. Real SMS is not wired yet.
OTP_PROVIDER=dev
