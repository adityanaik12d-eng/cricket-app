{
  "name": "@cricket-app/shared",
  "version": "1.0.0",
  "description": "Shared types and utilities for Cricket App",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.esm.js",
      "require": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.esm.js",
      "require": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -m ESNext --outDir dist/esm",
    "dev": "tsc -w",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "keywords": ["cricket", "shared", "types", "utilities"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "files": [
    "dist"
  ]
}